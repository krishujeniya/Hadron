# .dockerignore — Prevent sensitive credentials, agent files, and artifacts from leaking into images

# Version Control & Local Config
.git/
.gitignore
.github/
.vercelignore

# Local Credentials & Secrets (CRITICAL SECURITY BOUNDARY)
.aws/
.ssh/
.gnupg/
*.pem
*.key
*.cert
*.crt
.env*
!.env.example

# AI Agent Local Context & State
.agents/
.codex/
.gemini/
.claude/
.system_generated/
graphify-out/
brain/

# Python Virtual Environments & Caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Testing & Linting Artifacts
.pytest_cache/
.coverage*
htmlcov/
.ruff_cache/
.mypy_cache/

# Local SQLite & Databases
*.db
*.sqlite
*.sqlite3

# Logs & Temporary Files
*.log
tmp/
temp/
.DS_Store

# Frontend source and builds (built in dedicated frontend container)
frontend/
docs/
