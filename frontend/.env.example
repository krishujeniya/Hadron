# Hadron Frontend Environment Configuration
# Public variables exposed to browser bundles only

# Backend API endpoint (FastAPI hosted on Vercel)
NEXT_PUBLIC_API_BASE_URL=https://hadron-backend.vercel.app
NEXT_PUBLIC_API_DIRECT=1

# Canonical frontend application URL
NEXT_PUBLIC_APP_URL=https://krishujeniya.github.io/Hadron

# Base path for GitHub Pages deployment
NEXT_PUBLIC_BASE_PATH=/Hadron

# Static Vite bundle configuration
VITE_API_BASE_URL=https://hadron-backend.vercel.app
VITE_APP_URL=https://krishujeniya.github.io/Hadron
VITE_BASE_PATH=/Hadron
